  #table(
    columns: 3,
    align: left,
    [符号], [读法], [意思],
    [$(V,O,C)$], [ADT 三元组], [值、操作、前后置条件],
    [$I$], [表示不变式], [表示状态必须满足的谓词],
    [$O(1)$], [常数时间], [操作次数不随数据规模增长],
    [$O(n)$], [线性时间], [操作次数与数据规模成正比],
